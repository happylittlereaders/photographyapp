{
  "appId": "com.goldennumber.app",
  "appName": "Golden Number",
  "webDir": "www",
  "server": {
    "url": "https://goldennumber.streamlit.app",
    "cleartext": false,
    "androidScheme": "https"
  },
  "backgroundColor": "#000000ff",
  "ios": {
    "contentInset": "always"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0f0f0fff",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
